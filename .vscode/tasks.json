{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build workspace",
            "type": "shell",
            "command": "cargo build --workspace",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "build polyforge-server",
            "type": "shell",
            "command": "cargo build -p polyforge-server",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "build polyforge-client",
            "type": "shell",
            "command": "cargo build -p polyforge-client",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "build polyforge-pipeline",
            "type": "shell",
            "command": "cargo build -p polyforge-pipeline",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$rustc"]
        }
    ]
}
