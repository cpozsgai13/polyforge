# ─────────────────────────────────────────────────────────────────────────────
# polyforge-server
# ─────────────────────────────────────────────────────────────────────────────
ADDRESS=0.0.0.0
PORT=8443
DATABASE_URL=sqlite://data.db?mode=rwc
SECRET=SECRET
MAX_FILE_SIZE=10485760
TLS_CERT_PATH=certs/cert.pem
TLS_KEY_PATH=certs/key.pem
# Quote vendor: 'yahoo' (default).  Swap the Arc<dyn QuoteProvider> in main.rs
# and set this variable to switch to a different provider.
QUOTE_PROVIDER=yahoo
# Crypto symbols to seed from Binance on startup (comma-separated).
CRYPTO_SYMBOLS=BTC-USD,ETH-USD,SOL-USD
# Logging: actix_web=info shows one line per request; add ,debug for verbose.
RUST_LOG=actix_web=info,polyforge_server=debug

# ─────────────────────────────────────────────────────────────────────────────
# polyforge-client
# ─────────────────────────────────────────────────────────────────────────────
POLYFORGE_CLIENT_BASE_URL=https://localhost:8443
# Comma-separated list of symbols this client subscribes to.
# On startup the client fetches best_quote for each and stores them in memory.
POLYFORGE_CLIENT_SYMBOLS=AAPL,MSFT,NVDA
TRADING_ACCEPT_INVALID_CERTS=true

# ─────────────────────────────────────────────────────────────────────────────
# polyforge-pipeline
# ─────────────────────────────────────────────────────────────────────────────
POLYFORGE_PIPELINE_CONFIG=polyforge-pipeline/config.ini